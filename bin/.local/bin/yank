#!/bin/bash
#                              ██
#   ██   ██                   ░██
#  ░░██ ██   ██████   ███████ ░██  ██
#   ░░███   ░░░░░░██ ░░██░░░██░██ ██
#    ░██     ███████  ░██  ░██░████
#    ██     ██░░░░██  ░██  ░██░██░██
#   ██     ░░████████ ███  ░██░██░░██
#  ░░       ░░░░░░░░ ░░░   ░░ ░░  ░░
#
# henious edit of an osc52 clipboard script by samoshkin
# https://github.com/samoshkin/tmux-config/blob/master/tmux/yank.sh
# this version tries to push to every clipboard it possible can xD
# cc0 mmxxiii xero (https://x-e.ro | https://git.io/.files)

set -eu
# stdin or files; the trailing x stops $() from eating trailing newlines
buf=$(cat -- "$@"; printf x)
buf=${buf%x}

has() { command -v "$1" >/dev/null; }
out() { printf %s "$buf"; }

#█▓▒░ local clipboards
if has pbcopy; then
	# pbcopy decodes stdin by locale, and a C locale turns utf-8 into mojibake
	out | LC_ALL=en_US.UTF-8 pbcopy
elif [ -n "${WAYLAND_DISPLAY-}" ] && has wl-copy; then
	out | wl-copy
elif [ -n "${DISPLAY-}" ] && has xclip; then
	out | xclip -i -selection primary
	out | xclip -i -selection clipboard
elif [ -n "${DISPLAY-}" ] && has xsel; then
	out | xsel -ip
	out | xsel -ib
fi

#█▓▒░ osc 52, reaches the terminal you're sitting at even over ssh/mosh
# a 100_000 byte sequence leaves room for 74_994 bytes of text once base64'd
max=74994
len=$(out | wc -c)
[ "$len" -gt "$max" ] && printf 'yank: %d bytes over the osc 52 limit, truncated\n' $((len - max)) >&2

if [ -n "${TMUX-}" ]; then
	# tmux knows which client is attached and forwards it (needs set-clipboard on)
	out | tmux load-buffer -w -
else
	# the controlling tty, not stdout, so it still lands when stdout is a pipe
	{ printf '\033]52;c;%s\a' "$(out | head -c $max | base64 | tr -d '\r\n')" >/dev/tty; } 2>/dev/null || :
fi
